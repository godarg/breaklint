{
  "name": "breaklint",
  "version": "0.3.1",
  "description": "Layout checks for documents generated from HTML to PDF: measures every page after pagination and reports the measured value next to the threshold it failed.",
  "keywords": [
    "pagedjs",
    "paged-media",
    "html-to-pdf",
    "pdf",
    "print",
    "layout",
    "pagination",
    "page-break",
    "widows",
    "orphans",
    "linter",
    "typography"
  ],
  "license": "MIT",
  "author": "Gottlieb Dargel",
  "homepage": "https://dargel-solutions.de/en/breaklint/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godarg/breaklint.git"
  },
  "bugs": {
    "url": "https://github.com/godarg/breaklint/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "breaklint": "dist/cli/index.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./config.schema.json": "./breaklint.schema.json"
  },
  "files": [
    "dist/",
    "breaklint.schema.json",
    "examples/",
    "docs/",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run schema:check && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "schema:write": "tsx tools/write-config-schema.ts",
    "schema:check": "tsx tools/write-config-schema.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node tests/tools/test-with-tap.mjs",
    "test:live": "node tests/tools/live-run.mjs",
    "test:unit": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:mutants": "node --experimental-strip-types tests/tools/mutants.ts",
    "test:real-document": "node tests/tools/real-document-gate.mjs --cwd .",
    "test:pagination-residue": "node tests/tools/pagination-residue-gate.mjs --cwd .",
    "test:pagination-residue:red-control": "node tests/tools/pagination-residue-red-control.mjs",
    "test:real-document:red-control": "node tests/tools/real-document-red-control.mjs",
    "test:licenses": "node --experimental-strip-types tests/tools/licenses.ts",
    "test:secrets": "node tests/tools/secrets.mjs",
    "test:advisories": "node tests/tools/dependency-audit.mjs",
    "test:release-tag": "node tests/tools/release-tag-contract.mjs --self-test",
    "test:documented-figures": "node tests/tools/documented-figures.mjs --unit-tap .tmp/unit.tap --aggregate-tap .tmp/test.tap --live-summary .tmp/live-summary.json --live-report .tmp/live-report.json",
    "render:report-surfaces": "node --experimental-strip-types tests/tools/render-report-surfaces.mjs",
    "test:report-surface-mutants": "node tests/tools/report-surface-mutations.mjs",
    "test:report-surfaces": "npm run test:report-surfaces:local",
    "test:report-surfaces:local": "npm run render:report-surfaces && node tests/tools/verify-report-surfaces.mjs --mode local",
    "test:report-surfaces:technical": "npm run render:report-surfaces && node tests/tools/verify-report-surfaces.mjs --mode technical",
    "selfcheck:static": "node --experimental-strip-types tests/tools/selfcheck.ts",
    "selfcheck:live": "node tests/tools/selfcheck-live.mjs",
    "selfcheck": "npm run selfcheck:static && npm run selfcheck:live"
  },
  "peerDependencies": {
    "pagedjs": "0.4.3",
    "pdfjs-dist": "6.2.108",
    "puppeteer-core": ">=25.8.0 <26"
  },
  "peerDependenciesMeta": {
    "pagedjs": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "^8.18.0",
    "pagedjs": "0.4.3",
    "pdfjs-dist": "6.2.108",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.8.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "parse5": "8.0.1"
  }
}
