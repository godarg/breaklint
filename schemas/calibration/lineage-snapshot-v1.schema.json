{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breaklint.dev/schemas/calibration/lineage-snapshot-v1.schema.json",
  "title": "breaklint immutable evaluation lineage snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "snapshotId", "createdAt", "eventId", "holdoutLineageId", "holdoutId", "holdoutVersion", "freeze", "documentSplits", "knownOutcomeSha256s", "targetTuples", "artifacts"],
  "properties": {
    "contractVersion": { "const": "m3-0-lineage-snapshot-v1" },
    "snapshotId": { "type": "string", "pattern": "^lineage_snapshot_[A-Za-z0-9._-]{8,80}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "eventId": { "type": "string", "pattern": "^eval_[A-Za-z0-9._-]{8,80}$" },
    "holdoutLineageId": { "type": "string", "minLength": 8, "maxLength": 180 },
    "holdoutId": { "type": "string", "minLength": 8, "maxLength": 180 },
    "holdoutVersion": { "type": "integer", "minimum": 1 },
    "freeze": { "$ref": "https://breaklint.dev/schemas/calibration/corpus-manifest-v1.schema.json#/$defs/holdoutFreeze" },
    "documentSplits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/documentSplit" } },
    "knownOutcomeSha256s": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "targetTuples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/targetTuple" } },
    "artifacts": { "$ref": "#/$defs/artifacts" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ruleId": { "enum": ["svg/text-clipped", "svg/text-ink-collision", "svg/text-overflows-viewport"] },
    "documentSplit": {
      "type": "object", "additionalProperties": false, "required": ["documentId", "split"],
      "properties": { "documentId": { "type": "string", "minLength": 8 }, "split": { "enum": ["development", "tuning", "holdout"] } }
    },
    "targetTuple": {
      "type": "object", "additionalProperties": false,
      "required": ["documentId", "artifactSha256", "originGroupId", "targetId", "svgRootKey", "sourceIdentity", "ruleId", "oracleSnapshotSha256", "annotationSnapshotSha256", "adjudicationSnapshotSha256", "finalLabel", "ambiguityStatus", "rendererFreezeId", "rendererContentHash", "rendererSourceIdentitySha256"],
      "properties": { "documentId": { "type": "string", "minLength": 8 }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "originGroupId": { "type": "string", "minLength": 8 }, "targetId": { "type": "string", "minLength": 8 }, "svgRootKey": { "type": "string", "pattern": "^author-id:[A-Za-z][A-Za-z0-9_.:-]*$" }, "sourceIdentity": { "type": "string", "pattern": "^author-id:[A-Za-z][A-Za-z0-9_.:-]*$" }, "ruleId": { "$ref": "#/$defs/ruleId" }, "oracleSnapshotSha256": { "$ref": "#/$defs/sha256" }, "annotationSnapshotSha256": { "$ref": "#/$defs/sha256" }, "adjudicationSnapshotSha256": { "$ref": "#/$defs/sha256" }, "finalLabel": { "enum": ["positive", "negative", "ambiguous", "excluded_invalid"] }, "ambiguityStatus": { "enum": ["unambiguous", "ambiguous", "abstained", "invalid_target"] }, "rendererFreezeId": { "type": "string", "pattern": "^renderer_[a-f0-9]{64}$" }, "rendererContentHash": { "$ref": "#/$defs/sha256" }, "rendererSourceIdentitySha256": { "$ref": "#/$defs/sha256" } }
    },
    "encodedArtifact": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "bytesBase64"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "bytesBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 4 } }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["preregistrationReceipt", "acceptancePlan", "candidateSelection", "captureEvidenceBundle", "captureAttestation", "measurementReceipt", "productionEvaluation", "outcome", "acceptanceReport"],
      "properties": { "preregistrationReceipt": { "$ref": "#/$defs/encodedArtifact" }, "acceptancePlan": { "$ref": "#/$defs/encodedArtifact" }, "candidateSelection": { "$ref": "#/$defs/encodedArtifact" }, "captureEvidenceBundle": { "oneOf": [{ "$ref": "#/$defs/encodedArtifact" }, { "type": "null" }] }, "captureAttestation": { "oneOf": [{ "$ref": "#/$defs/encodedArtifact" }, { "type": "null" }] }, "measurementReceipt": { "$ref": "#/$defs/encodedArtifact" }, "productionEvaluation": { "$ref": "#/$defs/encodedArtifact" }, "outcome": { "$ref": "#/$defs/encodedArtifact" }, "acceptanceReport": { "$ref": "#/$defs/encodedArtifact" } }
    }
  }
}
