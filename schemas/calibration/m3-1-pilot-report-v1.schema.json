{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breaklint.dev/schemas/calibration/m3-1-pilot-report-v1.schema.json",
  "title": "breaklint M3-1 public corpus pilot report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "reportId",
    "createdAt",
    "purpose",
    "executionStatus",
    "manifestReference",
    "samplingPlanId",
    "samplingPlanSha256",
    "annotationSessions",
    "identityBindings",
    "holdoutFreezeReceipt",
    "externalAttestationProof",
    "trustPolicy",
    "documentCount",
    "originGroupCount",
    "annotatorCount",
    "adjudicatorCount",
    "claims",
    "evidenceTrust",
    "limitations"
  ],
  "properties": {
    "contractVersion": { "const": "m3-1-pilot-report-v1" },
    "reportId": { "type": "string", "pattern": "^pilot_report_[A-Za-z0-9._-]{8,80}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "purpose": { "const": "public-corpus-process-feasibility" },
    "executionStatus": { "enum": ["infrastructure-complete-external-execution-blocked", "pilot-complete-untrusted", "pilot-complete-externally-attested"] },
    "manifestReference": { "$ref": "#/$defs/manifestReference" },
    "samplingPlanId": { "type": "string", "pattern": "^sampling_[A-Za-z0-9._-]{8,80}$" },
    "samplingPlanSha256": { "$ref": "#/$defs/sha256" },
    "annotationSessions": { "type": "array", "items": { "$ref": "#/$defs/artifactReference" } },
    "identityBindings": { "type": "array", "items": { "$ref": "#/$defs/artifactReference" } },
    "holdoutFreezeReceipt": { "$ref": "#/$defs/nullableArtifactReference" },
    "externalAttestationProof": { "$ref": "#/$defs/nullableArtifactReference" },
    "trustPolicy": { "$ref": "#/$defs/nullableArtifactReference" },
    "documentCount": { "type": "integer", "minimum": 0 },
    "originGroupCount": { "type": "integer", "minimum": 0 },
    "annotatorCount": { "type": "integer", "minimum": 0 },
    "adjudicatorCount": { "type": "integer", "minimum": 0 },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realHumanAnnotationVerified",
        "identitySeparationVerified",
        "holdoutFreezeExternalValid",
        "captureAttestorTrustValid",
        "ruleReadyForCalibration",
        "ruleReadyForCalibratedClaim",
        "calibrated"
      ],
      "properties": {
        "realHumanAnnotationVerified": { "type": "boolean" },
        "identitySeparationVerified": { "type": "boolean" },
        "holdoutFreezeExternalValid": { "type": "boolean" },
        "captureAttestorTrustValid": { "type": "boolean" },
        "ruleReadyForCalibration": { "type": "boolean" },
        "ruleReadyForCalibratedClaim": { "type": "boolean" },
        "calibrated": { "const": false }
      }
    },
    "evidenceTrust": { "enum": ["untrusted", "externally-attested"] },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12, "maxLength": 500 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "evidenceTrust": { "const": "untrusted" } }, "required": ["evidenceTrust"] },
      "then": {
        "properties": {
          "claims": {
            "type": "object",
            "properties": {
              "realHumanAnnotationVerified": { "const": false },
              "identitySeparationVerified": { "const": false },
              "holdoutFreezeExternalValid": { "const": false },
              "captureAttestorTrustValid": { "const": false },
              "ruleReadyForCalibration": { "const": false },
              "ruleReadyForCalibratedClaim": { "const": false },
              "calibrated": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "executionStatus": { "const": "pilot-complete-externally-attested" } }, "required": ["executionStatus"] },
      "then": {
        "properties": {
          "annotationSessions": { "type": "array", "minItems": 2 },
          "identityBindings": { "type": "array", "minItems": 2 },
          "holdoutFreezeReceipt": { "$ref": "#/$defs/artifactReference" },
          "externalAttestationProof": { "$ref": "#/$defs/artifactReference" },
          "trustPolicy": { "$ref": "#/$defs/artifactReference" },
          "annotatorCount": { "type": "integer", "minimum": 2 },
          "evidenceTrust": { "const": "externally-attested" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactSha256", "artifactContractVersion"],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{7,180}$" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "artifactContractVersion": { "type": "string", "pattern": "^m3-[01]-[A-Za-z0-9._-]+-v[1-9][0-9]*$" }
      }
    },
    "manifestReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "artifactSha256", "artifactContractVersion"],
          "properties": {
            "artifactId": { "type": "string", "pattern": "^intake_manifest_[A-Za-z0-9._-]{8,80}$" },
            "artifactSha256": { "$ref": "#/$defs/sha256" },
            "artifactContractVersion": { "const": "m3-1-public-intake-manifest-v1" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "artifactSha256", "artifactContractVersion"],
          "properties": {
            "artifactId": { "type": "string", "pattern": "^manifest_[A-Za-z0-9._-]{8,80}$" },
            "artifactSha256": { "$ref": "#/$defs/sha256" },
            "artifactContractVersion": { "const": "m3-0-corpus-contract-v1" }
          }
        }
      ]
    },
    "nullableArtifactReference": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactReference" }]
    }
  }
}
