{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breaklint.dev/schemas/calibration/blind-packet-v3.schema.json",
  "title": "breaklint M3-1 raster-only blind packet v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "packetId", "blinded", "humanExecutable", "sourceDelivered", "targets", "packetSha256"],
  "properties": {
    "contractVersion": { "const": "m3-1-blind-packet-v3" },
    "packetId": { "type": "string", "pattern": "^blind_packet_[A-Za-z0-9._-]{8,80}$" },
    "blinded": { "const": true },
    "humanExecutable": { "const": true },
    "sourceDelivered": { "const": false },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
    "packetSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blindTargetId", "ruleId", "neutralOrder", "context"],
      "properties": {
        "blindTargetId": { "type": "string", "pattern": "^blind_target_[a-f0-9]{32}$" },
        "ruleId": { "enum": ["svg/text-clipped", "svg/text-ink-collision", "svg/text-overflows-viewport"] },
        "neutralOrder": { "type": "integer", "minimum": 1 },
        "context": { "$ref": "#/$defs/context" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "artifactSha256", "byteLength", "mediaType", "width", "height", "targetLocator", "renderingContract"],
      "properties": {
        "artifactPath": { "type": "string", "pattern": "^blind-context/context_[a-f0-9]{24}\\.png$" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "mediaType": { "const": "image/png" },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "targetLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "x", "y", "width", "height"],
          "properties": {
            "mode": { "const": "raster-pixel-bounds" },
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "renderingContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "rendererName", "rendererVersion", "rendererExecutableSha256", "assetManifestSha256", "fontManifestSha256", "sourceSubtreeSha256", "networkPolicy", "networkPositiveControlBlocked", "viewport", "independentContentVerificationRequired", "limitations"],
          "properties": {
            "mode": { "const": "pinned-network-denied-raster-v1" },
            "rendererName": { "type": "string", "minLength": 2, "maxLength": 80 },
            "rendererVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
            "rendererExecutableSha256": { "$ref": "#/$defs/sha256" },
            "assetManifestSha256": { "$ref": "#/$defs/sha256" },
            "fontManifestSha256": { "$ref": "#/$defs/sha256" },
            "sourceSubtreeSha256": { "$ref": "#/$defs/sha256" },
            "networkPolicy": { "const": "deny-all" },
            "networkPositiveControlBlocked": { "const": true },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height", "deviceScaleFactor", "colorSpace"],
              "properties": {
                "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
                "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
                "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
                "colorSpace": { "const": "srgb" }
              }
            },
            "independentContentVerificationRequired": { "const": true },
            "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 12, "maxLength": 500 } }
          }
        }
      }
    }
  }
}
