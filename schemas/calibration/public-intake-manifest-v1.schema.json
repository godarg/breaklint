{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breaklint.dev/schemas/calibration/public-intake-manifest-v1.schema.json",
  "title": "breaklint M3-1 public corpus intake manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "manifestId",
    "createdAt",
    "purpose",
    "documents",
    "claimEligible",
    "captureAttestorTrustValid",
    "calibrated",
    "evidenceTrust"
  ],
  "properties": {
    "contractVersion": { "const": "m3-1-public-intake-manifest-v1" },
    "manifestId": { "type": "string", "pattern": "^intake_manifest_[A-Za-z0-9._-]{8,80}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "purpose": { "const": "m3-1-public-corpus-intake" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "claimEligible": { "const": false },
    "captureAttestorTrustValid": { "const": false },
    "calibrated": { "const": false },
    "evidenceTrust": { "const": "untrusted-intake-only" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "opaqueGroupId": { "type": "string", "pattern": "^[a-z]+_group_[A-Za-z0-9._-]{8,80}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "artifact",
        "sourceLocator",
        "sourceCapturedAt",
        "sourceCaptureMode",
        "firstPartySourceSnapshot",
        "provenanceClass",
        "provenanceEvidenceSha256",
        "rightsBasis",
        "rightsEvidenceSha256",
        "privacyClass",
        "privacyEvidenceSha256",
        "founderAuthorizationSha256",
        "groups",
        "targets",
        "claimEligible",
        "captureAttestorTrustValid",
        "calibrated"
      ],
      "properties": {
        "documentId": { "type": "string", "pattern": "^doc_[A-Za-z0-9._-]{8,80}$" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "sourceLocator": { "type": "string", "pattern": "^source_[A-Za-z0-9._-]{8,120}$" },
        "sourceCapturedAt": { "type": "string", "format": "date-time" },
        "sourceCaptureMode": { "enum": ["https-byte-capture", "founder-authorized-source-snapshot", "synthetic-fixture-construction"] },
        "firstPartySourceSnapshot": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["commitSha", "blobSha1", "commitTime"],
              "properties": {
                "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
                "blobSha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
                "commitTime": { "type": "string", "format": "date-time" }
              }
            }
          ]
        },
        "provenanceClass": { "enum": ["synthetic-first-party", "public-first-party", "public-redistributable"] },
        "provenanceEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "rightsBasis": { "enum": ["first-party-founder-authorized", "public-domain", "cc0-1.0"] },
        "rightsEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "privacyClass": { "enum": ["synthetic-no-personal-data", "reviewed-no-personal-data", "reviewed-public-business-identity"] },
        "privacyEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "founderAuthorizationSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "groups": { "$ref": "#/$defs/groups" },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
        "claimEligible": { "const": false },
        "captureAttestorTrustValid": { "const": false },
        "calibrated": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "privacyClass": { "const": "reviewed-public-business-identity" } }, "required": ["privacyClass"] },
          "then": { "properties": { "founderAuthorizationSha256": { "$ref": "#/$defs/sha256" } } },
          "else": { "properties": { "founderAuthorizationSha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "provenanceClass": { "const": "public-first-party" } }, "required": ["provenanceClass"] },
          "then": {
            "properties": {
              "sourceCaptureMode": { "const": "founder-authorized-source-snapshot" },
              "firstPartySourceSnapshot": { "type": "object" }
            }
          }
        },
        {
          "if": { "properties": { "provenanceClass": { "const": "public-redistributable" } }, "required": ["provenanceClass"] },
          "then": {
            "properties": {
              "sourceCaptureMode": { "const": "https-byte-capture" },
              "firstPartySourceSnapshot": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "provenanceClass": { "const": "synthetic-first-party" } }, "required": ["provenanceClass"] },
          "then": {
            "properties": {
              "sourceCaptureMode": { "const": "synthetic-fixture-construction" },
              "firstPartySourceSnapshot": { "type": "null" }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byteLength", "mediaType", "relativePath"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "mediaType": { "enum": ["text/html", "image/svg+xml"] },
        "relativePath": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*~)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originGroupId", "duplicateGroupId", "derivationGroupId", "templateGroupId", "versionGroupId"],
      "properties": {
        "originGroupId": { "$ref": "#/$defs/opaqueGroupId" },
        "duplicateGroupId": { "$ref": "#/$defs/opaqueGroupId" },
        "derivationGroupId": { "$ref": "#/$defs/opaqueGroupId" },
        "templateGroupId": { "$ref": "#/$defs/opaqueGroupId" },
        "versionGroupId": { "$ref": "#/$defs/opaqueGroupId" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "artifactSha256", "ruleId", "svgRootLocator", "targetLocator"],
      "properties": {
        "targetId": { "type": "string", "pattern": "^target_[A-Za-z0-9._:-]{8,180}$" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "ruleId": { "enum": ["svg/text-clipped", "svg/text-ink-collision", "svg/text-overflows-viewport"] },
        "svgRootLocator": { "$ref": "#/$defs/sourceLocator" },
        "targetLocator": { "$ref": "#/$defs/sourceLocator" }
      }
    },
    "sourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "authorId"],
          "properties": {
            "mode": { "const": "author-id" },
            "authorId": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,119}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "structuralPath", "sourceSignatureSha256"],
          "properties": {
            "mode": { "const": "byte-bound-structural" },
            "structuralPath": { "type": "string", "pattern": "^/[A-Za-z0-9._:/@=\\[\\]-]{3,300}$" },
            "sourceSignatureSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    }
  }
}
