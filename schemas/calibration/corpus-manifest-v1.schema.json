{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breaklint.dev/schemas/calibration/corpus-manifest-v1.schema.json",
  "title": "breaklint calibration corpus manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaVersion",
    "manifestId",
    "createdAt",
    "documents",
    "preregistrationAnchors",
    "holdoutFreeze",
    "candidateSelections",
    "evaluationLedger",
    "readinessClaims"
  ],
  "properties": {
    "contractVersion": { "const": "m3-0-corpus-contract-v1" },
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "pattern": "^manifest_[A-Za-z0-9._-]{8,80}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    },
    "preregistrationAnchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/preregistrationAnchor" }
    },
    "holdoutFreeze": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/holdoutFreeze" }
      ]
    },
    "candidateSelections": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateSelection" }
    },
    "evaluationLedger": {
      "type": "array",
      "items": { "$ref": "#/$defs/evaluationEvent" }
    },
    "readinessClaims": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/readinessClaim" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{7,180}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "storage", "relativePath", "mediaType"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "storage": { "enum": ["public-repository", "external-private"] },
        "relativePath": { "type": ["string", "null"], "maxLength": 300 },
        "mediaType": { "enum": ["text/html", "image/svg+xml"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenanceClass", "sourceLocator", "sourceEvidence"],
      "properties": {
        "provenanceClass": {
          "enum": [
            "synthetic_first_party",
            "public_redistributable",
            "private_authorized",
            "private_nonredistributable"
          ]
        },
        "sourceLocator": { "type": "string", "minLength": 8, "maxLength": 240 },
        "sourceEvidence": { "type": "string", "minLength": 8, "maxLength": 1000 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": [
            "first_party",
            "public_domain",
            "permissive_redistribution_verified",
            "evaluation_only_authorized",
            "unknown"
          ]
        },
        "evidence": { "type": "string", "minLength": 8, "maxLength": 1000 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewEvidence"],
      "properties": {
        "status": {
          "enum": [
            "synthetic_no_personal_data",
            "reviewed_no_personal_data",
            "redacted_and_reviewed",
            "contains_personal_data_authorized_private",
            "unknown"
          ]
        },
        "reviewEvidence": { "type": "string", "minLength": 8, "maxLength": 1000 }
      }
    },
    "fontIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "resolvedId", "sha256"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "resolvedId": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rendererFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendererFreezeId",
        "sourceIdentity",
        "breaklintVersion",
        "nodeVersion",
        "browserProduct",
        "browserVersion",
        "browserExecutableSha256",
        "puppeteerVersion",
        "pagedjsVersion",
        "pagedjsArtifactSha256",
        "rasterizer",
        "rasterizerVersion",
        "headless",
        "deviceScaleFactor",
        "viewport",
        "pageSize",
        "locale",
        "timezone",
        "colorScheme",
        "os",
        "fonts",
        "customFontHashes",
        "networkMode",
        "resourceHashes"
      ],
      "properties": {
        "rendererFreezeId": { "type": "string", "pattern": "^renderer_[a-f0-9]{64}$" },
        "sourceIdentity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "commit"],
              "properties": {
                "mode": { "const": "clean-commit" },
                "commit": { "$ref": "#/$defs/gitSha1" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "baseCommit", "gitDiffSha256", "sourceTreeSha256", "sourceBundleSha256", "sourceScope"],
              "properties": {
                "mode": { "const": "dirty-source-bundle" },
                "baseCommit": { "$ref": "#/$defs/gitSha1" },
                "gitDiffSha256": { "$ref": "#/$defs/sha256" },
                "sourceTreeSha256": { "$ref": "#/$defs/sha256" },
                "sourceBundleSha256": { "$ref": "#/$defs/sha256" },
                "sourceScope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["inclusion", "exclusion"],
                  "properties": {
                    "inclusion": { "const": "git-tracked-and-untracked-nonignored" },
                    "exclusion": { "const": "gitignored-and-generated-outputs" }
                  }
                }
              }
            }
          ]
        },
        "breaklintVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "nodeVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "browserProduct": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 },
        "browserExecutableSha256": { "$ref": "#/$defs/sha256" },
        "puppeteerVersion": { "type": "string", "minLength": 1 },
        "pagedjsVersion": { "const": "0.4.3" },
        "pagedjsArtifactSha256": { "$ref": "#/$defs/sha256" },
        "rasterizer": { "type": "string", "minLength": 1 },
        "rasterizerVersion": { "type": "string", "minLength": 1 },
        "headless": { "type": "boolean" },
        "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 },
        "viewport": { "$ref": "#/$defs/dimensions" },
        "pageSize": { "$ref": "#/$defs/dimensions" },
        "locale": { "type": "string", "minLength": 2 },
        "timezone": { "type": "string", "minLength": 1 },
        "colorScheme": { "enum": ["light", "dark"] },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "version", "arch"],
          "properties": {
            "platform": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "arch": { "type": "string", "minLength": 1 }
          }
        },
        "fonts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fontIdentity" } },
        "customFontHashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "networkMode": { "enum": ["offline", "allowlisted"] },
        "resourceHashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" } }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["css-px", "mm"] }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracleVersion", "evidenceKinds", "groundTruth"],
      "properties": {
        "oracleVersion": { "const": "m3-0-oracle-v1" },
        "evidenceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "artifact-bytes",
              "authored-svg-semantics",
              "synthetic-construction",
              "neutral-counterfactual-render",
              "independent-render-geometry",
              "authored-viewport-boundary",
              "blind-human-annotation",
              "independent-adjudication"
            ]
          }
        },
        "groundTruth": { "enum": ["positive", "negative", "ambiguous", "excluded_invalid"] }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudicationId", "adjudicatorIds", "guidelineVersion", "createdAt", "finalLabel", "rationale"],
      "properties": {
        "adjudicationId": { "type": "string", "pattern": "^adj_[A-Za-z0-9._-]{8,80}$" },
        "adjudicatorIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^annotator_[A-Za-z0-9._-]{4,80}$" }
        },
        "guidelineVersion": { "type": "string", "pattern": "^svg-[a-z-]+-v[1-9][0-9]*$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "finalLabel": { "enum": ["positive", "negative", "ambiguous", "excluded_invalid"] },
        "rationale": { "type": "string", "minLength": 12, "maxLength": 2000 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "svgRootKey",
        "sourceIdentity",
        "ruleId",
        "oracle",
        "annotations",
        "ambiguityStatus",
        "adjudication"
      ],
      "properties": {
        "targetId": { "type": "string", "pattern": "^target_[A-Za-z0-9._:-]{8,180}$" },
        "svgRootKey": { "$ref": "#/$defs/opaqueId" },
        "sourceIdentity": { "type": "string", "pattern": "^(author-id|signature):[A-Za-z0-9._:-]{4,180}$" },
        "ruleId": {
          "enum": [
            "svg/text-clipped",
            "svg/text-ink-collision",
            "svg/text-overflows-viewport"
          ]
        },
        "oracle": { "$ref": "#/$defs/oracle" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "https://breaklint.dev/schemas/calibration/annotation-v1.schema.json" }
        },
        "ambiguityStatus": { "enum": ["unambiguous", "ambiguous", "abstained", "invalid_target"] },
        "adjudication": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/adjudication" }] }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "artifact",
        "realDocument",
        "split",
        "originGroupId",
        "duplicateGroupId",
        "derivationGroupId",
        "parentTemplateGroupId",
        "provenance",
        "license",
        "privacy",
        "capturedAt",
        "rendererFreeze",
        "targets"
      ],
      "properties": {
        "documentId": { "type": "string", "pattern": "^doc_[A-Za-z0-9._-]{8,80}$" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "realDocument": { "type": "boolean" },
        "split": { "enum": ["development", "tuning", "holdout"] },
        "originGroupId": { "$ref": "#/$defs/opaqueId" },
        "duplicateGroupId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/opaqueId" }] },
        "derivationGroupId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/opaqueId" }] },
        "parentTemplateGroupId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/opaqueId" }] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "license": { "$ref": "#/$defs/license" },
        "privacy": { "$ref": "#/$defs/privacy" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "rendererFreeze": { "$ref": "#/$defs/rendererFreeze" },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } }
      }
    },
    "holdoutFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdoutId",
        "holdoutLineageId",
        "preregistrationReceiptSha256",
        "version",
        "frozenAt",
        "reason",
        "approverId",
        "orderedDocuments",
        "manifestHash",
        "annotationHash",
        "adjudicationHash",
        "rendererFreezeIds",
        "acceptancePlanHashes"
      ],
      "properties": {
        "holdoutId": { "type": "string", "pattern": "^holdout_[A-Za-z0-9._-]{8,80}$" },
        "holdoutLineageId": { "type": "string", "pattern": "^lineage_[A-Za-z0-9._-]{8,80}$" },
        "preregistrationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "integer", "minimum": 1 },
        "frozenAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 12 },
        "approverId": { "type": "string", "pattern": "^approver_[A-Za-z0-9._-]{4,80}$" },
        "orderedDocuments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["documentId", "artifactSha256", "originGroupId"],
            "properties": {
              "documentId": { "type": "string", "pattern": "^doc_[A-Za-z0-9._-]{8,80}$" },
              "artifactSha256": { "$ref": "#/$defs/sha256" },
              "originGroupId": { "$ref": "#/$defs/opaqueId" }
            }
          }
        },
        "manifestHash": { "$ref": "#/$defs/sha256" },
        "annotationHash": { "$ref": "#/$defs/sha256" },
        "adjudicationHash": { "$ref": "#/$defs/sha256" },
        "rendererFreezeIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^renderer_[a-f0-9]{64}$" } },
        "acceptancePlanHashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }
      }
    },
    "preregistrationAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "receiptSha256", "planSha256", "holdoutLineageId", "holdoutId", "recordedAt", "firstHoldoutAccessAt"],
      "properties": {
        "receiptId": { "type": "string", "pattern": "^receipt_[A-Za-z0-9._-]{8,80}$" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "planSha256": { "$ref": "#/$defs/sha256" },
        "holdoutLineageId": { "type": "string", "pattern": "^lineage_[A-Za-z0-9._-]{8,80}$" },
        "holdoutId": { "type": "string", "pattern": "^holdout_[A-Za-z0-9._-]{8,80}$" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "firstHoldoutAccessAt": { "type": "string", "format": "date-time" }
      }
    },
    "evaluationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "createdAt", "purpose", "holdoutLineageId", "holdoutId", "holdoutVersion", "holdoutManifestHash", "rendererFreezeIds", "preregistrationReceiptSha256", "candidateConfigHash", "planSha256", "productionEvaluationSha256", "outcomeSha256", "acceptanceReportSha256", "lineageSnapshotSha256", "appendOnlySequence"],
      "properties": {
        "eventId": { "type": "string", "pattern": "^eval_[A-Za-z0-9._-]{8,80}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "purpose": { "const": "final-holdout-evaluation" },
        "holdoutLineageId": { "type": "string", "pattern": "^lineage_[A-Za-z0-9._-]{8,80}$" },
        "holdoutId": { "type": "string", "pattern": "^holdout_[A-Za-z0-9._-]{8,80}$" },
        "holdoutVersion": { "type": "integer", "minimum": 1 },
        "holdoutManifestHash": { "$ref": "#/$defs/sha256" },
        "rendererFreezeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^renderer_[a-f0-9]{64}$" } },
        "preregistrationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "candidateConfigHash": { "$ref": "#/$defs/sha256" },
        "planSha256": { "$ref": "#/$defs/sha256" },
        "productionEvaluationSha256": { "$ref": "#/$defs/sha256" },
        "outcomeSha256": { "$ref": "#/$defs/sha256" },
        "acceptanceReportSha256": { "$ref": "#/$defs/sha256" },
        "lineageSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "appendOnlySequence": { "type": "integer", "minimum": 1 }
      }
    },
    "candidateSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectionId",
        "ruleId",
        "createdAt",
        "holdoutLineageId",
        "holdoutId",
        "preregistrationReceiptSha256",
        "preregisteredPlanId",
        "planSha256",
        "candidateConfigHash",
        "thresholdCandidateHash",
        "inputSplits",
        "inputDocumentIds",
        "evidenceHashes",
        "holdoutOutcomeUsed"
      ],
      "properties": {
        "selectionId": { "type": "string", "pattern": "^selection_[A-Za-z0-9._-]{8,80}$" },
        "ruleId": {
          "enum": [
            "svg/text-clipped",
            "svg/text-ink-collision",
            "svg/text-overflows-viewport"
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "holdoutLineageId": { "type": "string", "pattern": "^lineage_[A-Za-z0-9._-]{8,80}$" },
        "holdoutId": { "type": "string", "pattern": "^holdout_[A-Za-z0-9._-]{8,80}$" },
        "preregistrationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "preregisteredPlanId": { "$ref": "#/$defs/opaqueId" },
        "planSha256": { "$ref": "#/$defs/sha256" },
        "candidateConfigHash": { "$ref": "#/$defs/sha256" },
        "thresholdCandidateHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "inputSplits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["development", "tuning", "holdout"] }
        },
        "inputDocumentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^doc_[A-Za-z0-9._-]{8,80}$" }
        },
        "evidenceHashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "holdoutOutcomeUsed": { "type": "boolean" }
      }
    },
    "readinessClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "calibrationMode",
        "ruleReadyForCalibration",
        "ruleReadyForCalibratedClaim",
        "calibratedClaim",
        "eligibleRealDocuments",
        "eligibleOriginGroups",
        "acceptedSamplingPlan",
        "candidateConfigHash",
        "rendererFreezeId",
        "rendererContentHash",
        "thresholdCandidateHash",
        "acceptanceGateVersion",
        "acceptancePlanSha256",
        "preregistrationReceiptSha256",
        "holdoutLineageId",
        "outcomeSha256",
        "acceptanceReportSha256"
      ],
      "properties": {
        "ruleId": {
          "enum": [
            "svg/text-clipped",
            "svg/text-ink-collision",
            "svg/text-overflows-viewport"
          ]
        },
        "calibrationMode": { "enum": ["empirical-threshold", "structural-validation"] },
        "ruleReadyForCalibration": { "type": "boolean" },
        "ruleReadyForCalibratedClaim": { "type": "boolean" },
        "calibratedClaim": { "type": "boolean" },
        "eligibleRealDocuments": { "type": "integer", "minimum": 0 },
        "eligibleOriginGroups": { "type": "integer", "minimum": 0 },
        "acceptedSamplingPlan": { "type": "boolean" },
        "candidateConfigHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "rendererFreezeId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^renderer_[a-f0-9]{64}$" }] },
        "rendererContentHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "thresholdCandidateHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "acceptanceGateVersion": { "type": ["string", "null"], "minLength": 1 },
        "acceptancePlanSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "preregistrationReceiptSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "holdoutLineageId": { "type": ["string", "null"], "pattern": "^lineage_[A-Za-z0-9._-]{8,80}$" },
        "outcomeSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "acceptanceReportSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] }
      }
    }
  }
}
