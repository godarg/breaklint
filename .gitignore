node_modules/
dist/
*.tsbuildinfo
.DS_Store
npm-debug.log*

# Generated during a run. Evidence images and PDFs are produced, never committed.
breaklint-report/
*.png
*.pdf
!tests/fixtures/**/expected-*.png

# Published brand assets, deliberately committed. The social preview is uploaded to the
# repository settings by hand, so the file has to stay in the tree to be re-uploadable.
!assets/*.png

# Local scratch
.tmp/
.artifacts/
coverage/

# Public corpus artifacts may be committed only under corpus/public/. These names are guards,
# not approved private storage locations; M3-1 has no approved private corpus store.
corpus/private/
corpus/restricted/
.private-corpus/

# Local agent tooling. These are symlinks into a checkout outside this repository; committing
# them would publish absolute paths from the machine they were made on.
.claude/

# npm pack output
*.tgz
